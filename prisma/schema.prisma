generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------
// CORE MULTI-TENANT SAAS MODELS
// -----------------------------------------
model Client {
  id          String   @id @default(uuid())
  name        String   
  slug        String   @unique 
  sector      String   
  
  phone       String?
  email       String?
  address     String?
  instagram   String?
  
  status      String   @default("DRAFT") // DRAFT, LIVE, ARCHIVED
  customDomain String? @unique
  tags        String?  // JSON or comma separated
  
  themeConfig ThemeConfig?
  features    FeatureConfig?
  
  users        User[]
  services     Service[]
  staff        Staff[]
  appointments Appointment[]
  rooms        Room[]
  reservations Reservation[]
  patients     Patient[]
  
  menuCategories    MenuCategory[]
  tableReservations TableReservation[]
  legalPracticeAreas LegalPracticeArea[]
  consultations     Consultation[]
  membershipPlans   MembershipPlan[]
  classSchedules    ClassSchedule[]
  projects          Project[]
  vehicles          Vehicle[]
  testDriveReservations TestDriveReservation[]
  
  ecomCategories    EcomCategory[]
  ecomProducts      EcomProduct[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ThemeConfig {
  id           String @id @default(uuid())
  clientId     String @unique
  client       Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  primaryColor String @default("#1A1A1A") 
  accentColor  String @default("#B59461")
  fontFamily   String @default("Inter")
  logoUrl      String?
}

model FeatureConfig {
  id          String @id @default(uuid())
  clientId    String @unique
  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  hasQrMenu   Boolean @default(false)
  hasBooking  Boolean @default(false)
  hasEcom     Boolean @default(false)
  hasBlog     Boolean @default(false)
}

// -----------------------------------------
// AUTH & ROLES
// -----------------------------------------
enum Role {
  SUPERADMIN
  OWNER
  STAFF
  CUSTOMER
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String 
  name     String
  role     Role   @default(CUSTOMER)
  
  clientId String? 
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// BEAUTY CENTER (BOOKING MODULE)
// -----------------------------------------
model Service {
  id          String  @id @default(uuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  description String? @db.Text
  duration    Int     // in minutes
  price       Decimal @db.Decimal(10,2)
  
  appointments Appointment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Staff {
  id          String  @id @default(uuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  title       String?
  avatarUrl   String?
  
  appointments Appointment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ApptStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment {
  id            String  @id @default(uuid())
  clientId      String
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  serviceId     String
  service       Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  
  staffId       String?
  staff         Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  
  customerName  String
  customerPhone String
  
  date          DateTime
  status        ApptStatus @default(PENDING)
  notes         String? @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


// -----------------------------------------
// HOTEL MODULE
// -----------------------------------------
model Room {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  roomNumber    String
  roomType      String   // STANDARD, SUITE, DELUXE
  capacity      Int
  pricePerNight Decimal  @db.Decimal(10,2)
  isAvailable   Boolean  @default(true)
  
  reservations  Reservation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Reservation {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  
  customerName  String
  customerPhone String
  checkInDate   DateTime
  checkOutDate  DateTime
  totalAmount   Decimal  @db.Decimal(10,2)
  status        String   // PENDING, CONFIRMED, CANCELLED, CHECKED_IN, CHECKED_OUT

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------
// DOCTOR / CLINIC MODULE
// -----------------------------------------
model Patient {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  phone       String
  email       String?
  birthDate   DateTime?
  
  records     MedicalRecord[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MedicalRecord {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  diagnosis   String?  @db.Text
  notes       String   @db.Text
  prescription String? @db.Text
  date        DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------
// RESTAURANT MODULE
// -----------------------------------------
model MenuCategory {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  order       Int      @default(0)
  items       MenuItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id          String   @id @default(uuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10,2)
  imageUrl    String?
  isAvailable Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TableReservation {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  customerName  String
  customerPhone String
  guestCount    Int
  date          DateTime
  status        String   // PENDING, CONFIRMED, CANCELLED
  specialRequests String? @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------
// LAW FIRM MODULE
// -----------------------------------------
model LegalPracticeArea {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  description String   @db.Text
  iconUrl     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Consultation {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  clientName    String
  clientPhone   String
  clientEmail   String?
  caseDescription String @db.Text
  date          DateTime
  status        String   // PENDING, REVIEWED, REJECTED, ACCEPTED

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------
// FITNESS MODULE
// -----------------------------------------
model MembershipPlan {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  price       Decimal  @db.Decimal(10,2)
  durationMonths Int
  features    String   @db.Text // JSON string or comma separated

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassSchedule {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  className   String
  trainerName String
  dayOfWeek   String
  startTime   String
  endTime     String
  capacity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------
// ARCHITECTURE MODULE
// -----------------------------------------
model Project {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  title       String
  category    String   // RESIDENTIAL, COMMERCIAL, INTERIOR
  description String   @db.Text
  location    String?
  year        Int?
  imageUrl    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------
// AUTO GALLERY MODULE
// -----------------------------------------
model Vehicle {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  brand       String
  model       String
  year        Int
  price       Decimal  @db.Decimal(12,2)
  mileage     Int
  fuelType    String
  transmission String
  imageUrl    String?
  status      String   // IN_STOCK, SOLD

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestDriveReservation {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  vehicleId     String
  customerName  String
  customerPhone String
  date          DateTime
  status        String   // PENDING, CONFIRMED, COMPLETED, CANCELLED

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------
// STUDIO OS MODELS (Internal SaaS Management)
// -----------------------------------------

model ThemeTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String   // SAAS, ECOMMERCE, BEAUTY, etc.
  description String?  @db.Text
  previewUrl  String?
  isPremium   Boolean  @default(false)
  config      String?  @db.Text // JSON configuration of the theme
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UIComponent {
  id          String   @id @default(uuid())
  name        String
  type        String   // HERO, NAVBAR, FOOTER, CTA, PRICING, etc.
  themeId     String?  // If it belongs to a specific theme
  code        String   @db.Text // The actual React/JSX code or JSON definition
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CopilotSession {
  id          String   @id @default(uuid())
  title       String?
  userId      String   // Admin/Staff user running the session
  
  messages    CopilotMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CopilotMessage {
  id          String   @id @default(uuid())
  sessionId   String
  session     CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  role        String   // user, system, assistant
  content     String   @db.Text
  tokensUsed  Int      @default(0)

  createdAt   DateTime @default(now())
}

model StudioSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id          String   @id @default(uuid())
  provider    String   // OPENAI, STRIPE, RESEND
  key         String
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------
// EMTECH STORE (E-COMMERCE MODULE)
// -----------------------------------------
model EcomCategory {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  slug        String
  order       Int      @default(0)
  
  products    EcomProduct[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EcomProduct {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    EcomCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10,2)
  brand       String?
  imageUrl    String?
  inStock     Boolean  @default(true)
  isNew       Boolean  @default(false)
  isFeatured  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
